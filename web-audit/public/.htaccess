# Kept deliberately minimal: shared hosts often disallow Options overrides, and
# any rejected directive here turns every page into a 500. Everything below is
# guarded by IfModule so an unavailable module is skipped rather than fatal.

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>
