# Copy to .env and fill in. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=web_audit
DB_USER=web_audit
DB_PASS=

# PageSpeed Insights API key (https://developers.google.com/speed/docs/insights/v5/get-started)
# Without a key the API allows only a handful of requests per minute.
PSI_API_KEY=

# A page scoring below this opens a task automatically.
SCORE_THRESHOLD=80

# Optional shared password for the UI. Leave empty to disable the login screen.
APP_PASSWORD=

APP_TIMEZONE=UTC
HTTP_TIMEOUT=120
