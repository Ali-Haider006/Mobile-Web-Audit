# The document root should be public/. This is a belt-and-braces guard for
# servers pointed at the project root by mistake. No Options directive here:
# many shared hosts reject it and answer every request with a 500.

<FilesMatch "^\.env|\.sql$|\.md$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
